# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Security Secret Key for JWT & Session signing
SECRET_KEY="replace_with_a_secure_random_secret_in_production"

# Admin Authentication
ADMIN_USERNAME="Noxiusvideo"
# Precomputed bcrypt hash of admin password
ADMIN_PASSWORD_HASH=""

# Video Storage
VIDEO_STORAGE_PATH="./uploads/videos"

# Adsterra Smartlink Monetization
ADSTERRA_SMARTLINK="https://www.profitableratecpmnetwork.com/hdkjs77b?key=c3356c7e4bb7b947eca2122ea103e099"
SMARTLINK_ENABLED=true

# Temporary Session Configuration
DEFAULT_EXPIRY_MINUTES=10

# Maximum Video Upload Size in Megabytes (Default: 2048 MB = 2GB)
MAX_UPLOAD_SIZE_MB=2048

# Database Configuration (Optional PostgreSQL connection string for production)
DATABASE_URL="file:./data/db.json"

